{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wlad232/aaif-round2-baseline/schema/case-record.schema.json",
  "title": "AAIF I&T delegated-authority case record (0.1)",
  "description": "One record per implementation per case for a comparison round. Fields follow the record requirements drafted in wg-identity-and-trust #13 (terms draft 0.2, section 7) and the residual rule of #22. A record states what was observed and what was not; it is not a conformance claim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "implementation", "case", "declared", "evidence", "residual"],
  "properties": {
    "schema_version": { "const": "aaif-aad-case-record/0.1" },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "release", "revision", "operator", "label"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "release": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "served_revision": { "type": "string" },
        "operator": { "type": "string", "minLength": 1 },
        "label": { "enum": ["independently_run", "author_operated"] },
        "synthetic": { "type": "boolean" }
      }
    },
    "case": { "enum": ["1", "2", "3", "4", "5", "5a", "5b", "6", "7", "8"] },
    "declared": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["measured", "not_measured", "not_applicable", "not_emitted"] },
        "policy": { "enum": ["stop", "finish_within", "not_applicable"] },
        "bound_s": { "type": "number", "minimum": 0 }
      }
    },
    "start_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "time", "source"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "time": { "type": "string", "format": "date-time" },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "outcome", "reason_code"],
      "properties": {
        "time": { "type": "string", "format": "date-time" },
        "outcome": { "enum": ["allowed", "refused", "not_observed"] },
        "reason_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
        "path": { "type": "string" },
        "status_version": { "type": "string" },
        "status_age_s": { "type": "number", "minimum": 0 },
        "declared_bound_s": { "type": "number", "minimum": 0 }
      }
    },
    "in_flight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "observed"],
      "properties": {
        "policy": { "enum": ["stop", "finish_within", "not_applicable"] },
        "observed": { "enum": ["stopped", "finished", "unknown", "not_applicable"] },
        "target_observation": { "type": "string" }
      }
    },
    "limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "evidence"],
      "properties": {
        "kind": { "enum": ["fixed_allocation", "pooled_draw"] },
        "evidence": { "type": "string", "minLength": 1 },
        "aggregate_scope": { "type": "string" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_sha256"],
      "properties": {
        "record_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "uri": { "type": "string" }
      }
    },
    "residual": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "case": { "enum": ["1", "3", "4"] } }, "required": ["case"] },
      "then": { "required": ["start_event"] }
    },
    {
      "if": { "properties": { "case": { "const": "3" } }, "required": ["case"] },
      "then": { "required": ["decision"], "properties": { "decision": { "required": ["status_age_s", "declared_bound_s"] } } }
    },
    {
      "if": { "properties": { "case": { "enum": ["5a", "5b"] } }, "required": ["case"] },
      "then": { "required": ["limit"] }
    }
  ]
}
